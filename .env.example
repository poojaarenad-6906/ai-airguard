# AI AirGuard Environment Configuration
# Copy this file to .env and fill in your keys.
# The app works WITHOUT any keys using clearly-labelled demo/sample data.

# ── Air Quality Data (OpenWeatherMap) ─────────────────────────────
# Get a FREE key at: https://openweathermap.org/appid
# Enables live AQI, PM2.5, PM10 data for any city worldwide.
VITE_OWM_API_KEY=your_api_key_here

# ── AI Chat Assistant (Groq) ───────────────────────────────────────
# Get a FREE key at: https://console.groq.com
# Upgrades the chat from rule-based demo to real AI (llama3-8b-8192).
VITE_GROQ_API_KEY=your_groq_api_key_here