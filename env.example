# AI AirGuard - Environment Variables
# Copy this file to .env.local and fill in your values

# ── IBM watsonx.ai (required for IBM Granite) ───────────────────────────────
VITE_WATSONX_API_KEY=your_ibm_cloud_api_key_here
VITE_WATSONX_PROJECT_ID=your_watsonx_project_id_here

# ── Backend credentials (Flask — never sent to browser) ─────────────────────
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small

# ── Groq (optional LLM fallback) ────────────────────────────────────────────
VITE_GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── OpenWeatherMap (optional — enables live AQI data) ───────────────────────
OWM_API_KEY=your_openweathermap_key_here

# ── JWT Authentication ───────────────────────────────────────────────────────
# Change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret-string

# ── Email Notifications (SMTP) ───────────────────────────────────────────────
# Gmail example: use an App Password (not your login password)
# See: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password_here
FROM_NAME=AI AirGuard
FROM_ADDR=your_gmail_address@gmail.com

# ── Application URL (used in email links) ───────────────────────────────────
APP_URL=http://localhost:5000

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
